@startuml VaultGuard-C4-Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title VaultGuard RWA - C4 Component

Person(investor, "Investor", "Authenticated investor")
Person(admin, "Super Admin", "Authenticated administrator")
System_Ext(kyc, "KYC/AML Provider", "External verification")
System_Ext(chain, "EVM T-REX Network", "Permissioned blockchain")

Container_Boundary(bff, "Next.js BFF") {
    Component(routeGuard, "Role Path Guard", "BFF middleware", "Allows only dashboard or governance paths for the session role.")
    Component(proxy, "Backend Proxy", "Route handler", "Forwards Bearer, tenant and wallet context; removes linkage probes.")
}

Container_Boundary(backend, "Spring Boot API") {
    Component(auth, "Authentication and Tenant Context", "JWT + refresh", "Resolves role, scopes, tenant and authenticated wallet.")
    Component(interceptor, "API Authorization Interceptor", "Security filter", "Default-deny role and scope matrix for every API route.")
    Component(marketplace, "Marketplace and Linkage Service", "Service", "Applies PUBLIC/PRIVATE visibility, created_by and contracted/invited linkage.")
    Component(kycService, "KYC and Compliance Service", "Service", "Own-document access, approval states, sanctions adapter and chain gating.")
    Component(lifecycle, "Offering and Lifecycle Service", "Service", "Creates, publishes, pauses, closes, subscribes and redeems scoped offerings.")
    Component(oracle, "Oracle and ForceSync Service", "Service + worker", "Bounded retry, four-eyes approval and chain-write state transitions.")
    Component(preflight, "Transfer Preflight Service", "Service", "Advisory canTransfer check; refreshes before wallet signature.")
    Component(audit, "Append-only Audit Service", "Service", "Records privileged actions, denied access and blockchain transactions.")
    Component(persistence, "Tenant-scoped Persistence", "JDBC repositories", "Persists PII references, offerings, ACLs, audit and transaction records.")
    Component(gateway, "Blockchain Gateway", "Gateway + TransactionSigner", "Reads T-REX state and submits receipt-tracked transactions without end-user keys.")
}

Rel(investor, routeGuard, "Uses dashboard")
Rel(admin, routeGuard, "Uses governance")
Rel(routeGuard, proxy, "Passes allowed request")
Rel(proxy, auth, "Provides JWT and request context")
Rel(proxy, interceptor, "Calls protected API")
Rel(interceptor, marketplace, "Authorizes linked catalog access")
Rel(interceptor, kycService, "Authorizes own/admin KYC access")
Rel(interceptor, lifecycle, "Authorizes admin lifecycle operations")
Rel(marketplace, persistence, "Queries linked offerings and grants")
Rel(kycService, kyc, "Submits and polls verification")
Rel(kycService, oracle, "Queues approved identity")
Rel(lifecycle, gateway, "Deploys suite, mints and pauses")
Rel(preflight, gateway, "Runs advisory staticcall")
Rel(oracle, gateway, "Registers or revokes identity")
Rel(audit, persistence, "Appends audit and chain records")
Rel(gateway, audit, "Emits transaction outcome")
Rel(gateway, chain, "Reads and writes T-REX state")

SHOW_LEGEND()
@enduml
