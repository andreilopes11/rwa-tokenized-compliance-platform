@startuml VaultGuard-C4-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title VaultGuard RWA - C4 Container

Person(investor, "Investor", "End user")
Person(admin, "Super Admin", "Offering and compliance administrator")
System_Ext(kyc, "KYC/AML Provider", "External verification")
System_Ext(chain, "EVM T-REX Network", "Permissioned blockchain")
System_Ext(wallet, "Investor Wallet", "Transfer signer")

System_Boundary(vaultguard, "VaultGuard RWA") {
	Container(web, "Next.js Workspaces + BFF", "Next.js, App Router", "Role-based /dashboard and /governance workspaces; HttpOnly JWT boundary; wallet and tenant headers.")
	Container(api, "Spring Boot API", "Java, Spring Boot, com.rwa", "Authorization, KYC, marketplace linkage, lifecycle, preflight, audit and governance services.")
	ContainerDb(db, "PostgreSQL", "PostgreSQL", "Tenant-scoped offerings, identities, encrypted document references, ACLs, audit events and chain transactions.")
	Container(worker, "Oracle and Recovery Worker", "Spring worker", "Bounded retry from off-chain approval to IdentityRegistry; ForceSync four-eyes workflow.")
	Container(gateway, "Blockchain Gateway", "Java Web3 + TransactionSigner", "Per-offering T-REX address resolution, staticcall preflight and receipt-confirmed transactions.")
}

Rel(investor, web, "Uses dashboard")
Rel(admin, web, "Uses governance")
Rel(web, api, "Calls BFF routes over HTTPS")
Rel(api, db, "Reads and writes scoped data")
Rel(api, kyc, "Uses KYC adapter")
Rel(api, worker, "Queues approval and recovery work")
Rel(worker, gateway, "Requests identity registry writes")
Rel(gateway, chain, "Reads and signs T-REX transactions")
Rel(investor, wallet, "Signs transfer")
Rel(wallet, chain, "Submits transfer")
Rel(api, gateway, "Runs advisory preflight and lifecycle operations")

SHOW_LEGEND()
@enduml
